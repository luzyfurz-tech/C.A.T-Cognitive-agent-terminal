# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Browser Configuration (Raspberry Pi Support)
# On Raspberry Pi, install chromium with: sudo apt install chromium
# Then set this to: /usr/bin/chromium (check with 'which chromium')
CHROMIUM_PATH=""

# Ollama Configuration
# The system is designed to run exclusively via Ollama Cloud.
OLLAMA_HOST="https://ollama.com"
OLLAMA_API_KEY=""
