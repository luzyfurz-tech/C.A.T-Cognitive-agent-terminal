# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Browser Configuration (Raspberry Pi Support)
# On Raspberry Pi, install chromium with: sudo apt install chromium-browser
# Then set this to: /usr/bin/chromium-browser
CHROMIUM_PATH=""

# Ollama Configuration
# The system is designed to run exclusively via Ollama.
# If using a self-hosted instance (e.g. on your Pi), set this to http://localhost:11434
# If using a cloud tunnel or specific endpoint, set the full URL.
OLLAMA_HOST="https://ollama.com"
OLLAMA_API_KEY=""
